{
  "manifest_version": 3,
  "name": "Monsters Analyzer for D&D Beyond",
  "version": "0.5.0",
  "description": "Unofficial. Scan a D&D Beyond page for referenced monsters and analyze their CR, defenses, and damage output.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": ["*://*.dndbeyond.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Analyze monsters on this page",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
